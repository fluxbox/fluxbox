# nls/Makemodule.am for fluxbox - http://fluxbox.org

# nls/fluxbox-nls.yaml is the source of all translations; nls/fluxbox-nls.py
# creates nls/*/generated*.m and nls/catalogs.am from it
nls_gencat = $(AM_V_GEN)$(MKDIR_P) $(@D) && rm -f $@ && $(gencat_cmd) $@

include $(top_srcdir)/nls/catalogs.am

EXTRA_DIST += \
	$(nls_MFILES) \
	nls/catalogs.am \
	nls/fluxbox-nls.py \
	nls/fluxbox-nls.yaml

# remove the folders of the catalogs, then $(LOCALE_PATH)
.PHONY: uninstall-nls
uninstall-nls:
	@for d in $(nls_CATDIRS); do \
		if test -d "$(DESTDIR)$(LOCALE_PATH)/$$d"; then \
			rmdir "$(DESTDIR)$(LOCALE_PATH)/$$d" || exit 1; \
		fi; \
	done
	@if test -d "$(DESTDIR)$(LOCALE_PATH)"; then \
		rmdir "$(DESTDIR)$(LOCALE_PATH)"; \
	fi

fluxbox-nls.hh:
	chmod +x $(srcdir)/nlsinfo
	$(srcdir)/nlsinfo -H -N FBNLS $(top_srcdir)/src $(top_srcdir)/util > fluxbox-nls.hh
